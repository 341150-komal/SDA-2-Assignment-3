{"exportVersion":10,"dashboards":{"dashboard-1":{"title":"Payment System Real-Time Transaction & Fraud Dashboard","layout":[{"w":2,"h":1,"x":0,"y":0,"i":"item-1"},{"w":2,"h":1,"x":2,"y":0,"i":"item-2"},{"w":2,"h":1,"x":4,"y":0,"i":"item-3"},{"w":8,"h":2,"x":0,"y":1,"i":"item-4"},{"w":4,"h":2,"x":0,"y":3,"i":"item-5"},{"w":4,"h":2,"x":4,"y":3,"i":"item-6"},{"w":8,"h":2,"x":0,"y":5,"i":"item-7"}],"description":"Executive view of the e-commerce Payment System stream (Producer → Kafka payment-transactions → MongoDB/Fraud consumers → transactions_a3 / fraud_alerts_a3). 3 headline KPIs + 4 insight-first charts: each chart leads with a computed rate or ranked value rather than a raw breakdown.","embedding":{"anonymousAuthEnabled":false},"filters":[{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Payment Method","linkedFields":[{"dataSourceId":"data-source-1","fieldPath":"payment_method"},{"dataSourceId":"data-source-2","fieldPath":"payment_method"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Payment Gateway","linkedFields":[{"dataSourceId":"data-source-1","fieldPath":"payment_gateway"},{"dataSourceId":"data-source-2","fieldPath":"payment_gateway"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Merchant Region","linkedFields":[{"dataSourceId":"data-source-1","fieldPath":"merchant_region"},{"dataSourceId":"data-source-2","fieldPath":"merchant_region"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Device Type","linkedFields":[{"dataSourceId":"data-source-1","fieldPath":"device_type"},{"dataSourceId":"data-source-2","fieldPath":"device_type"}]},{"disabled":false,"type":"String","settings":{"allOthers":true,"values":[]},"name":"Transaction Status","linkedFields":[{"dataSourceId":"data-source-1","fieldPath":"transaction_status"},{"dataSourceId":"data-source-2","fieldPath":"transaction_status"}]}]}},"items":{"item-1":{"title":"Payment Success Rate (%)","description":"DERIVED = share of transactions with transaction_status = SUCCESS. The single headline number for whether checkout is working today.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"is_success","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$eq\": [\n        \"$transaction_status\",\n        \"SUCCESS\"\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\": [{\"$eq\": [\"$transaction_status\", \"SUCCESS\"]}, 100, 0]}"}],"channels":{"value":{"field":"is_success","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Payment Success Rate (%)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"1"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"8dbed22b-f883-4003-be45-f7250ac04155"}},"item-2":{"title":"Total Transaction Value (₹)","description":"BASE. Sum of amount across all captured transactions — scale of money flowing through the payment system.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"value":{"field":"amount","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Total Transaction Value (₹)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"d52c9387-e2f3-4efc-bee7-acd933eb9787"}},"item-3":{"title":"Fraud Value at Risk (₹)","description":"DERIVED = sum of amount for transactions where is_fraud = true. Money-at-risk is more actionable for leadership than a raw fraud transaction count.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"number","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"fraud_value","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$eq\": [\n        \"$is_fraud\",\n        true\n      ]\n    },\n    \"$amount\",\n    0\n  ]\n}","derivedMQL":"{\"$cond\": [{\"$eq\": [\"$is_fraud\", true]}, \"$amount\", 0]}"}],"channels":{"value":{"field":"fraud_value","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{},"axes":{},"channels":{"value":{"labelOverride":{"enabled":true,"value":"Fraud Value at Risk (₹)"},"numberFormatting":{"enabled":true,"value":"Custom"},"numberDecimals":{"enabled":true,"value":"0"}}},"conditionalFormatting":[]},"chartType":"Number","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"c59637ea-2bb9-43b6-a747-945035bec5cc"}},"item-4":{"title":"Transaction Metrics Overview by 8-Minute Intervals","description":"","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"combo-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"minute_ist","rawExpression":"{\n  \"$dateToString\": {\n    \"format\": \"%m-%d %H:%M\",\n    \"date\": {\n      \"$dateFromString\": {\n        \"dateString\": \"$event_ts\",\n        \"onError\": null,\n        \"onNull\": null\n      }\n    },\n    \"timezone\": \"Asia/Kolkata\"\n  }\n}","derivedMQL":"{\"$dateToString\": {\"format\": \"%m-%d %H:%M\", \"date\": {\"$dateFromString\": {\"dateString\": \"$event_ts\", \"onError\": null, \"onNull\": null}}, \"timezone\": \"Asia/Kolkata\"}}"},{"fieldPath":"is_success","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$eq\": [\n        \"$transaction_status\",\n        \"SUCCESS\"\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\": [{\"$eq\": [\"$transaction_status\", \"SUCCESS\"]}, 100, 0]}"}],"channels":{"y":{"field":"transaction_count","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"x":{"field":"_id","type":"nominal","inferredType":"Date","channelType":"category","isBinning":true,"temporalBinning":["year","month","date","hours","minutes"]},"ylines":{"field":"success_rate","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"}},"reductions":{},"customisations":{"options":{"dataValueLabels":{"enabled":true,"value":null},"labelSize":{"enabled":true,"value":"80"}},"axes":{"x":{"categoryLabelAngle":{"enabled":true,"value":"vertical"}},"y":{},"ylines2":{}},"channels":{"y":{"numberFormatting":{"enabled":true,"value":"Default"}},"x":{"minutePreset":{"enabled":true,"value":"h:mm A"},"dateTimeFormatting":{"enabled":true,"value":"DD-MMM-YYYY h:mm A"}},"ylines":{"numberFormatting":{"enabled":true,"value":"Custom"},"numberGrouping":{"enabled":false,"value":null},"numberDecimals":{"enabled":true,"value":"2"},"numberMultiplier":{"enabled":true,"value":"100"},"numberSuffix":{"enabled":true,"value":"%"},"plotOnSecondaryAxis":{"enabled":true,"value":null}}},"conditionalFormatting":[]},"chartType":"Grouped Combo","meta":{},"sample":false,"query":"[\n  { \"$addFields\": {\n      \"ts\": { \"$dateFromString\": { \"dateString\": \"$event_ts\" } },\n      \"success_flag\": { \"$cond\": [{ \"$eq\": [\"$transaction_status\", \"SUCCESS\"] }, 1, 0] }\n  }},\n  { \"$addFields\": {\n      \"bucket\": { \"$dateTrunc\": { \"date\": \"$ts\", \"unit\": \"minute\", \"binSize\": 10 } }\n  }},\n  { \"$group\": {\n      \"_id\": \"$bucket\",\n      \"transaction_count\": { \"$sum\": 1 },\n      \"success_rate\": { \"$avg\": \"$success_flag\" }\n  }},\n  { \"$sort\": { \"_id\": 1 } }\n]","queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"6427ef42-25c1-46e7-b759-6b393757bfcd"}},"item-5":{"title":"2. Payment Gateway — Failure Rate (%)","description":"DERIVED = FAILED/DECLINED share per gateway. Sort this bar descending in the chart view so the gateway needing escalation sits on top.","dashboardId":"dashboard-1","dataSourceId":"data-source-1","iconValue":"bar-grouped","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[{"fieldPath":"is_failed_pct","rawExpression":"{\n  \"$cond\": [\n    {\n      \"$in\": [\n        \"$transaction_status\",\n        [\n          \"FAILED\",\n          \"DECLINED\"\n        ]\n      ]\n    },\n    100,\n    0\n  ]\n}","derivedMQL":"{\"$cond\": [{\"$in\": [\"$transaction_status\", [\"FAILED\", \"DECLINED\"]]}, 100, 0]}"}],"channels":{"x":{"field":"failure_rate","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"mean"},"y":{"field":"_id","type":"nominal","inferredType":"String","channelType":"category","isBinning":false}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB"]},"dataValueLabels":{"enabled":true,"value":null}},"axes":{"x":{}},"channels":{"x":{"numberFormatting":{"enabled":true,"value":"Default"}},"y":{}},"conditionalFormatting":[]},"chartType":"Grouped Bar","meta":{},"sample":false,"query":"[\n  { \"$group\": {\n      \"_id\": \"$payment_gateway\",\n      \"failure_rate\": { \"$avg\": { \"$cond\": [{ \"$in\": [\"$transaction_status\", [\"FAILED\", \"DECLINED\"]] }, 1, 0] } }\n  }},\n  { \"$sort\": { \"failure_rate\": -1 } }\n]","queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"063e5043-e1db-45cd-8a32-41bf47bdbd