 and 'what kind' in one read.","dashboardId":"dashboard-1","dataSourceId":"data-source-2","iconValue":"bar-stacked","itemType":"chart","filters":[],"missedFields":[],"lookupFields":[],"convertedFields":[],"calculatedFields":[],"channels":{"y":{"field":"merchant_region","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"},"x":{"field":"amount","type":"quantitative","inferredType":"Number","channelType":"aggregation","aggregate":"sum"},"color":{"field":"alert_type","type":"nominal","inferredType":"String","transformedType":"String","channelType":"category"}},"reductions":{},"customisations":{"options":{"colorDiscrete":{"enabled":true,"value":["#1392AB","#16CC62","#E6B219","#E6196E","#196EE6","#E65D19","#19C3E6","#116149","#80340E","#ABABAB","#73E0A1","#8CB6F2"]}},"axes":{},"channels":{"y":{"labelOverride":{"enabled":true,"value":"Merchant region"}},"x":{"labelOverride":{"enabled":true,"value":"Fraud value at risk (₹)"},"numberFormatting":{"enabled":true,"value":"Default"}},"color":{"labelOverride":{"enabled":true,"value":"Fraud type"}}},"conditionalFormatting":[]},"chartType":"Stacked Bar","meta":{},"sample":false,"query":null,"queryId":null,"interactiveFiltering":"highlight","embedding":{"id":"97bf950a-0f9f-4165-9ff6-10897b8c78e1"}}},"dataSources":{"data-source-1":{"alias":"transactions_a3","collection":"transactions_a3","database":"payment_system","deployment":"Cluster0","sourceType":"cluster"},"data-source-2":{"alias":"fraud_alerts_a3","collection":"fraud_alerts_a3","database":"payment_system","deployment":"Cluster0","sourceType":"cluster"}},"queries":{}}